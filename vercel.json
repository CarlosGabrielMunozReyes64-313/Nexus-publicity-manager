{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://nexus-publicity-manager-bakend-production.up.railway.app/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://nexus-publicity-manager-bakend-production.up.railway.app/health"
    },
    {
      "source": "/baja/:path*",
      "destination": "https://nexus-publicity-manager-bakend-production.up.railway.app/baja/:path*"
    },
    {
      "source": "/r/:path*",
      "destination": "https://nexus-publicity-manager-bakend-production.up.railway.app/r/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
